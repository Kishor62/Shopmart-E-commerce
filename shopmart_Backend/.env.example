# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (local ya MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/shopmart

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (product images upload ke liye) - optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (online payment ke liye) - optional
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Seed script ke liye admin account
ADMIN_EMAIL=admin@shopmart.com
ADMIN_PASSWORD=Admin@12345
